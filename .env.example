# Copy to .env (git-ignored) and fill in:   cp .env.example .env
# Used by docker-compose.yml for local development.

# SQL Server "sa" password. SQL Server requires 8+ chars with upper, lower, digit and symbol.
# Avoid ";" (it breaks the connection string) and "$" (compose treats it as a variable).
SA_PASSWORD=ChangeMe_Local1!

# JWT signing key shared by the .NET API and the BFF. At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_KEY=replace-with-output-of-openssl-rand-base64-48
